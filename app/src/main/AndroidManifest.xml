<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"/>
    <uses-feature android:name="android.hardware.wifi" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.ar" android:required="false"/>
    <uses-feature android:name="android.hardware.uwb" android:required="false"/>
    <application android:label="RF Lab" android:allowBackup="false" android:theme="@style/Theme.RFLab">
        <meta-data android:name="com.google.ar.core" android:value="optional"/>
        <activity android:name=".AcousticLabActivity" android:exported="false"/>
        <activity android:name=".SpatialScanActivity" android:exported="false"/>
        <activity android:name=".OpenVinsScanActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.AppCompat.NoActionBar"/>
        <!-- Internal GPLv3 VIO activity: same APK, same Android target SDK. -->
        <activity android:name="com.openvins.android.MainActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.AppCompat.NoActionBar"/>
        <activity android:name=".RgbdSurfaceViewerActivity" android:exported="false"/>
        <activity android:name=".DepthComparisonActivity" android:exported="false"/>
        <activity android:name=".PhotoCaptureActivity" android:exported="false"/>
        <activity android:name=".PhotoGalleryActivity" android:exported="false"/>
        <activity android:name=".PhotoReviewActivity" android:exported="false"/>
        <activity android:name=".OfflineReconstructionActivity" android:exported="false"/>
        <activity android:name=".MagneticLabActivity" android:exported="false"/>
        <activity android:name=".DiagnosticsActivity" android:exported="false"/>
        <activity android:name=".MainActivity" android:exported="false"/>
        <activity android:name=".SpatialHomeActivity" android:exported="false"/>
        <activity android:name=".SpatialSetupActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
